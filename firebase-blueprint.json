{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "An event on the calendar",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The title of the event" },
        "description": { "type": "string", "description": "A detailed description" },
        "startTime": { "type": "string", "format": "date-time", "description": "ISO timestamp for start" },
        "endTime": { "type": "string", "format": "date-time", "description": "ISO timestamp for end" },
        "allDay": { "type": "boolean", "description": "Whether it's an all-day event" },
        "color": { "type": "string", "description": "Hex color code" },
        "userId": { "type": "string", "description": "The user ID of the owner" },
        "reminders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["email", "notification", "alarm"] },
              "minutesBefore": { "type": "number" },
              "status": { "type": "string", "enum": ["pending", "sent", "failed"] }
            }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "startTime", "endTime", "userId"]
    },
    "User": {
      "title": "User",
      "description": "User preferences and metadata",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "settings": {
          "type": "object",
          "properties": {
            "theme": { "type": "string", "enum": ["light", "dark", "system"] },
            "defaultView": { "type": "string", "enum": ["month", "week", "day"] }
          }
        }
      }
    }
  },
  "firestore": {
    "/events/{eventId}": {
      "schema": "Event",
      "description": "Calendar events"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    }
  }
}
